# Supabase Configuration
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Paystack Configuration
# Obtain from your Paystack Dashboard -> Settings -> API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Upstash Redis Configuration (Payment API Rate Limiting)
# Obtain from your Upstash Console -> Redis Database -> REST API
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here

# Application Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: set to your actual domain, e.g. https://jobnexa.ng
NEXT_PUBLIC_SITE_URL=http://localhost:3000
